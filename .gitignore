# Secrets — NEVER commit
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated outputs (not source code)
outputs/

# Local data / test fixtures (may contain PII)
data/
!data/.gitkeep

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Build artifacts
dist/
build/

# local discovery JSON store (when not using Postgres)
data/discovery_store.json
data/*.corrupt

# Repowise local index (generated by 'repowise init'; never commit)
.repowise/
.build-stamp
.mcp.json
.claude/CLAUDE.md

# Generated doc artifacts (renders of the tracked .md sources, built by
# scripts/md_to_pdf.py + scripts/docshots.py). Large binaries stay local.
docs/*.pdf
docs/*.html
docs/images/*
!docs/images/linkedin_flow_diagram.png

# Meeting-prep scratch, not a product doc
docs/review_prep.md
